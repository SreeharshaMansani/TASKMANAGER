# Existing task manager API
REACT_APP_API_URL=http://localhost:5000

# Widget API origin: may be hosted separately from TaskManager.
# Production example: https://assistant-api.example.com (no /api/chat suffix).
# Allow this TaskManager site's origin in the chatbot server FRONTEND_ORIGIN setting.
# Reuses TaskManager login; keep provider API keys on the chatbot server only.
REACT_APP_CHATBOT_URL=http://localhost:3001
